{
  "name": "travlr",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node ./bin/www",
    "db:seed": "cd app_server && node ./models/seed",
    "install:all": "npm install && cd app_angular && npm install && cd ../app_react && npm install",
    "launch": "concurrently \"npm run start:backend\" \"npm run start:angular\" \"npm run start:react\"",
    "start:angular": "cd app_angular && npx ng serve",
    "start:backend": "cd app_server && npm start",
    "start:react": "cd app_react && npm run dev"
  },
  "dependencies": {
    "@angular/cli": "^21.2.7",
    "bootstrap": "^5.3.8",
    "concurrently": "^9.2.1",
    "cookie-parser": "~1.4.4",
    "crypto": "^1.0.1",
    "debug": "~2.6.9",
    "dotenv": "^17.4.2",
    "express": "^4.22.1",
    "express-jwt": "^8.5.1",
    "handlebars": "^4.7.8",
    "hbs": "^4.2.1",
    "http-errors": "~1.6.3",
    "jquery": "^4.0.0",
    "json": "^11.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.3",
    "morgan": "^1.10.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  }
}
